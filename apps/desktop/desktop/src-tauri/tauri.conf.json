{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LearnFlow",
  "version": "0.3.1",
  "identifier": "com.learnflow.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix ../frontend run dev:web",
    "beforeBuildCommand": "npm --prefix ../frontend run build",
    "devUrl": "http://localhost:4175",
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "LearnFlow",
        "width": 1440,
        "height": 920,
        "minWidth": 1024,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset: http://127.0.0.1:*; connect-src 'self' http://127.0.0.1:* http://localhost:4175 ws://localhost:4175; img-src 'self' asset: http://127.0.0.1:* data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/learnflow-backend"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "learnflow"
        ]
      }
    }
  }
}
