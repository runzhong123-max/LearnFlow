# Local development secrets belong in .env.local, never in this tracked template.
MIMO_API_KEY=
GLM_API_KEY=
TAVILY_API_KEY=

# Optional defaults used when no tab-scoped override is present.
ROLE_ATLAS_MODEL_PROVIDER=mimo
ROLE_ATLAS_MODEL=mimo-v2.5
ROLE_ATLAS_MODEL_BASE_URL=
ROLE_ATLAS_SEARCH_PROVIDER=glm
ROLE_ATLAS_SEARCH_ENGINE=search_pro
# Agent research for snapshot iteration. Set to 1 to let a planned, tool-using
# research agent run on top of the deterministic pipeline: the supervisor turns
# work items into task cards, workers research them, claims are evidence-reviewed
# before they may influence a graph write, and spending is charged to a ledger
# that withholds a review reserve. Unset keeps the deterministic path exactly as
# before. See docs/research-orchestration-creed.md.
ROLE_ATLAS_RESEARCH_AGENT=0
# Optional isolated local D1/R2 state directory for browser acceptance tests.
ROLE_ATLAS_STATE_DIR=

# Shared identity authority. Role Atlas forwards the opaque LearnFlow session
# to /api/auth/me and never stores LearnFlow passwords or session tokens.
LEARNFLOW_BASE_URL=http://localhost:8000
LEARNFLOW_PUBLIC_URL=http://localhost:4174
ROLE_ATLAS_PUBLIC_URL=http://localhost:3000
GRAPH_HUB_PUBLIC_URL=http://localhost:3000

# Shared HMAC secret used only for short-lived, subject-bound package handoffs.
# Production value must contain at least 32 bytes and match LearnFlow.
ROLE_PACKAGE_LAUNCH_SECRET=

# Server-to-server ecosystem API; never use PUBLIC/NEXT_PUBLIC/VITE prefixes.
# Match the central LearnFlow server secret (at least 32 bytes).
ROLE_ATLAS_GATEWAY_SECRET=
# Dedicated production gateway Worker: expose only the signed gateway endpoint.
# Keep the authoring product behind its existing private ingress separately.
ROLE_ATLAS_GATEWAY_ONLY=false
