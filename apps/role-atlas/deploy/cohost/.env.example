COMPOSE_PROJECT_NAME=cohost
LEARNFLOW_REPO_PATH=../../../..
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
ROOT_HOST=example.com
LEARNFLOW_HOST=learn.example.com
ROLE_ATLAS_HOST=roles.example.com
GRAPH_HUB_HOST=graphs.example.com
AUTH_COOKIE_DOMAIN=.example.com

# Generate independent random secrets before launch. Do not commit values.
AUTH_RUNTIME_BRIDGE_TOKEN=
AUTH_API_KEY_KEK=
ROLE_ATLAS_GATEWAY_SECRET=
ROLE_PACKAGE_LAUNCH_SECRET=
REGISTRATION_INVITE_CODE=
DEFAULT_ACCOUNT_CREDIT_LIMIT=-1

# Role Atlas providers. DeepSeek handles model calls; Tavily handles web search.
DEEPSEEK_API_KEY=
GLM_API_KEY=
TAVILY_API_KEY=
ROLE_ATLAS_MODEL_PROVIDER=deepseek
ROLE_ATLAS_MODEL=deepseek-v4-flash
ROLE_ATLAS_SEARCH_PROVIDER=glm
ROLE_ATLAS_SEARCH_ENGINE=search_pro

# LearnFlow platform-wide model and optional search/video integrations.
# Provider credentials are server-only and are never entered by end users.
LEARNFLOW_LLM_API_KEY=
LEARNFLOW_LLM_BASE_URL=https://api.deepseek.com
LEARNFLOW_LLM_MODEL=deepseek-v4-flash
# Optional LearnFlow Tutor planning budgets. Leave defaults unless the selected
# provider needs a different response or context window.
LEARNFLOW_TUTOR_MAX_OUTPUT_TOKENS=6000
LEARNFLOW_TUTOR_PLANNING_MAX_OUTPUT_TOKENS=12000
LEARNFLOW_TUTOR_PLANNING_RECOVERY_MAX_OUTPUT_TOKENS=6000
LEARNFLOW_TUTOR_PLANNING_CONTEXT_MESSAGES=12
LEARNFLOW_TUTOR_PLANNING_CONTEXT_ENVELOPE_CHARS=12000
LEARNFLOW_TUTOR_PLANNING_CONTEXT_OBSERVATION_CHARS=2400
LEARNFLOW_TUTOR_PLANNING_CONTEXT_OBSERVATION_TOTAL_CHARS=8000
LEARNFLOW_TUTOR_PLANNING_TOOL_DESCRIPTION_CHARS=360
LEARNFLOW_VISION_API_KEY=
LEARNFLOW_VISION_BASE_URL=https://api.moonshot.cn/v1
LEARNFLOW_VISION_MODEL=moonshot-v1-8k-vision-preview
JINA_API_KEY=
EXA_API_KEY=
YOUTUBE_API_KEY=
GITHUB_TOKEN=
