# All browser products share the existing LearnFlow session authority.
(site_auth_api) {
  handle /api/auth/* {
    reverse_proxy learnflow-backend:8010
  }
  handle /site-session.js {
    reverse_proxy learnflow-frontend:4174
  }
}
(browser_gate) {
  forward_auth learnflow-backend:8010 {
    uri /api/auth/me
    @login status 401
    handle_response @login {
      redir https://{$LEARNFLOW_HOST}/login?return_to=https://{host}{http.request.orig_uri} 302
    }
  }
  header Cache-Control "no-store"
}
(api_gate) {
  forward_auth learnflow-backend:8010 {
    uri /api/auth/me
  }
  header Cache-Control "no-store"
}

{$ROOT_HOST} {
  encode zstd gzip
  route {
    import site_auth_api
    handle /login {
      redir https://{$LEARNFLOW_HOST}{uri} 302
    }
    handle {
      import browser_gate
      rewrite * /showcase.html
      reverse_proxy learnflow-frontend:4174
    }
  }
}

{$LEARNFLOW_HOST} {
  encode zstd gzip
  route {
    import site_auth_api
    @public path /login /assets/* /favicon.svg /api/health /api/platform
    handle @public {
      reverse_proxy learnflow-frontend:4174
    }
    handle /api/* {
      import api_gate
      reverse_proxy learnflow-frontend:4174
    }
    handle {
      import browser_gate
      reverse_proxy learnflow-frontend:4174
    }
  }
}

(atlas_site) {
  encode zstd gzip
  route {
    import site_auth_api
    # Machine gateway retains its signature/subject verification, no cookie login.
    handle /api/integrations/learnflow/gateway {
      reverse_proxy role-atlas:3000 {
        header_up Host localhost
      }
    }
    handle /api/integrations/learnflow/launch {
      import api_gate
      reverse_proxy role-atlas-launch-proxy:3010
    }
    handle /api/* {
      import api_gate
      reverse_proxy role-atlas:3000 {
        header_up Host localhost
      }
    }
    handle {
      import browser_gate
      reverse_proxy role-atlas:3000 {
        header_up Host localhost
      }
    }
  }
}
{$ROLE_ATLAS_HOST} {
  import atlas_site
}
{$GRAPH_HUB_HOST} {
  @root path /
  redir @root /hub 302
  import atlas_site
}

http://:8081 {
  reverse_proxy https://api.deepseek.com {
    header_up Host api.deepseek.com
  }
}

# Unknown HTTP hosts and direct-IP requests must not bypass the login entry.
http://:80 {
  redir https://{$LEARNFLOW_HOST}/login 302
}
