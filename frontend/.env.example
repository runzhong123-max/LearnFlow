# Copy this file to .env.local. The global key is a local-development migration
# fallback only; normal use stores one encrypted key per signed-in account.
LEARNFLOW_API_KEY=

# Server-only credential bridge. Prefer defining the same 32+ character value
# in backend/.env; Vite reads it server-side and never embeds it in browser JS.
AUTH_RUNTIME_BRIDGE_TOKEN=

# Optional. npm run dev starts the local formal backend at this address when
# needed. Set this only when the formal backend lives elsewhere.
LEARNFLOW_BACKEND_URL=http://127.0.0.1:8010
# Browser origin(s) allowed to call the server-side Tutor proxy in production.
LEARNFLOW_PUBLIC_ORIGIN=http://localhost:4174

# Tutor output/context budgets. Server-only; override per deployment when the
# selected provider needs a different planning response or context window.
LEARNFLOW_TUTOR_MAX_OUTPUT_TOKENS=6000
LEARNFLOW_TUTOR_PLANNING_MAX_OUTPUT_TOKENS=12000
LEARNFLOW_TUTOR_PLANNING_RECOVERY_MAX_OUTPUT_TOKENS=6000
LEARNFLOW_TUTOR_PLANNING_CONTEXT_MESSAGES=12
LEARNFLOW_TUTOR_PLANNING_CONTEXT_ENVELOPE_CHARS=12000
LEARNFLOW_TUTOR_PLANNING_CONTEXT_OBSERVATION_CHARS=2400
LEARNFLOW_TUTOR_PLANNING_CONTEXT_OBSERVATION_TOTAL_CHARS=8000
LEARNFLOW_TUTOR_PLANNING_TOOL_DESCRIPTION_CHARS=360

# Optional scoped Graph Hub catalog consumed by the role graph plugin. A
# learner-scoped catalog is bound to learnflow:learner:<id> and fails closed
# for any other signed-in learner.
LEARNFLOW_GRAPH_HUB_CATALOG=
# Preferred multi-user layout: catalogs/public.json plus
# subjects/<sha256(learnflow:learner:<id>)>/catalog.json.
LEARNFLOW_GRAPH_HUB_CATALOG_ROOT=
LEARNFLOW_GRAPH_HUB_BASE_URL=http://localhost:3000
LEARNFLOW_ROLE_AGENT_BASE_URL=http://localhost:3000
# Writable root for role packages installed at runtime
# (npm run role:import-release). Packages land here and are scanned as an
# `installed` source, so a pinned reference can resolve without a restart-costing
# copy into the bundled, read-only data/packages directory. Unset keeps the
# previous behaviour: installs go to the bundled root.
LEARNFLOW_ROLE_PACKAGE_HOME=
# Extra read-only roots scanned for static role packages (path delimiter
# separated). Development also infers apps/role-atlas/packages automatically.
LEARNFLOW_ROLE_AGENT_PACKAGE_ROOTS=

# Optional search providers. Without these, LearnFlow uses the public Jina
# search endpoint plus zero-key knowledge adapters such as Wikipedia,
# Stack Exchange, GitHub and arXiv. Exa takes priority over Tavily when set.
JINA_API_KEY=
EXA_API_KEY=
TAVILY_API_KEY=

# Optional. Enables live YouTube candidate search in the learning-video
# Harness. Bilibili and the fixed offline evaluation catalog do not use it.
YOUTUBE_API_KEY=
