    "id": "systems_deadlock_wait_cycle",
    "title": "死锁：持有资源与循环等待",
    "domains": [
      "computer_science"
    ],
    "teaching": {
      "goal": "区分持有关系和等待关系，观察两线程如何无法推进。",
      "assumptions": [
        "人工维护的固定教学分镜；运行时只校验结构和绑定，不验证领域过程真值。",
        "两把不可抢占的单实例锁；等待环在多实例资源中未必充分说明死锁。"
      ],
      "misconceptions": [],
      "checkpoints": []
    },
    "parameters": [],
    "data": {
      "columns": [
        "对象 / 位置",
        "状态 / 内容"
      ],
      "stages": [
        {
          "id": "stage_0",
          "title": "线程 A 获得 L1",
          "narration": "B 尚未持锁，A 可以继续执行。",
          "content": {
            "rows": [
              [
                "A 持有",
                "L1"
              ],
              [
                "B 持有",
                "无"
              ],
              [
                "等待",
                "无"
              ]
            ],
            "graph": {
              "nodes": [
                "a",
                "b"
              ],
              "labels": {
                "a": "线程 A",
                "b": "线程 B"
              },
              "edges": [],
              "directed": true
            }
          }
        },
        {
          "id": "stage_1",
          "title": "线程 B 获得 L2",
          "narration": "两者各持有一把不同的锁。",
          "content": {
            "rows": [
              [
                "A 持有",
                "L1"
              ],
              [
                "B 持有",
                "L2"
              ],
              [
                "等待",
                "无"
              ]
            ],
            "graph": {
              "nodes": [
                "a",
                "b"
              ],
              "labels": {
                "a": "线程 A",
                "b": "线程 B"
              },
              "edges": [],
              "directed": true
            }
          }
        },
        {
          "id": "stage_2",
          "title": "A 请求 L2",
          "narration": "L2 被 B 持有，A 等待 B 释放。",
          "content": {
            "rows": [
              [
                "A 持有",
                "L1"
              ],
              [
                "B 持有",
                "L2"
              ],
              [
                "等待边",
                "A → B"
              ]
            ],
            "graph": {
              "nodes": [
                "a",
                "b"
              ],
              "labels": {
                "a": "线程 A",
                "b": "线程 B"
              },
              "edges": [
                [
                  "a",
                  "b"
                ]
              ],
              "directed": true
            }
          }
        },
        {
          "id": "stage_3",
          "title": "B 请求 L1",
          "narration": "B 等待 A，形成等待环；两者都不释放已持有的锁。",
          "content": {
            "rows": [
              [
                "A 等待",
                "B 的 L2"
              ],
              [
                "B 等待",
                "A 的 L1"
              ],
              [
                "等待环",
                "A → B → A"
              ]
            ],
            "graph": {
              "nodes": [
                "a",
                "b"
              ],
              "labels": {
                "a": "线程 A",
                "b": "线程 B"
              },
              "edges": [
                [
                  "a",
                  "b"
                ],
                [
                  "b",
                  "a"
                ]
              ],
              "directed": true
            }
          }
        },
        {
          "id": "stage_4",
          "title": "统一顺序的替代执行",
          "narration": "若双方都先申请 L1 再申请 L2，B 会在持有任何锁前等待 L1，避免这个环。",
          "content": {
            "rows": [
              [
                "加锁规则",
                "L1 → L2"
              ],
              [
                "边界",
                "只解释锁顺序破环，不保证所有活性性质"
              ]
            ],
            "graph": {
              "nodes": [
                "a",
                "b"
              ],
              "labels": {
                "a": "线程 A",
                "b": "线程 B"
              },
              "edges": [
                [
                  "b",
                  "a"
                ]
              ],
              "directed": true
            }
          }
        }
      ]
    },
