  "spec": {
    "spec_version": "0.2.0",
    "id": "data_structures_linked_list_insert",
    "title": "单链表插入：为什么先接后断",
    "domains": [
      "computer_science"
    ],
    "teaching": {
      "goal": "用指针关系观察插入节点时如何保留原后继。",
      "assumptions": [
        "人工维护的固定教学分镜；运行时只校验结构和绑定，不验证领域过程真值。",
        "仅演示 A 后插入 X；不涵盖并发、内存释放或空指针检查。"
      ],
      "misconceptions": [],
      "checkpoints": []
    },
    "parameters": [],
    "data": {
      "columns": [
        "对象 / 位置",
        "状态 / 内容"
      ],
      "stages": [
        {
          "id": "stage_0",
          "title": "插入前",
          "narration": "A 指向 B，X 是新节点。",
          "content": {
            "rows": [
              [
                "head",
                "A"
              ],
              [
                "A.next",
                "B"
              ],
              [
                "X.next",
                "null"
              ],
              [
                "B.next",
                "null"
              ]
            ],
            "graph": {
              "nodes": [
                "a",
                "x",
                "b"
              ],
              "labels": {
                "a": "A",
                "x": "X",
                "b": "B"
              },
              "edges": [
                [
                  "a",
                  "b"
                ]
              ],
              "directed": true
            }
          }
        },
        {
          "id": "stage_1",
          "title": "保存后继",
          "narration": "先执行 X.next = A.next，把 B 保存在 X 的后继关系中。",
          "content": {
            "rows": [
              [
                "head",
                "A"
              ],
              [
                "A.next",
                "B"
              ],
              [
                "X.next",
                "B"
              ],
              [
                "B.next",
                "null"
              ]
            ],
            "graph": {
              "nodes": [
                "a",
                "x",
                "b"
              ],
              "labels": {
                "a": "A",
                "x": "X",
                "b": "B"
              },
              "edges": [
                [
                  "a",
                  "b"
                ],
                [
                  "x",
                  "b"
                ]
              ],
              "directed": true
            }
          }
        },
        {
          "id": "stage_2",
          "title": "接入新节点",
          "narration": "再执行 A.next = X，沿 head 能依次访问三个节点。",
          "content": {
            "rows": [
              [
                "head",
                "A"
              ],
              [
                "A.next",
                "X"
              ],
              [
                "X.next",
                "B"
              ],
              [
                "遍历",
                "A → X → B"
              ]
            ],
            "graph": {
              "nodes": [
                "a",
                "x",
                "b"
              ],
              "labels": {
                "a": "A",
                "x": "X",
                "b": "B"
              },
              "edges": [
                [
                  "a",
                  "x"
                ],
                [
                  "x",
                  "b"
                ]
              ],
              "directed": true
            }
          }
        },
        {
          "id": "stage_3",
          "title": "反例检查",
          "narration": "如果先 A.next=X 再 X.next=A.next，X 会指回自己；原 B 可能失去可达路径。",
          "content": {
            "rows": [
              [
                "错误 X.next",
                "X"
              ],
              [
                "错误结构",
                "A → X → X …"
              ],
              [
                "正确原则",
                "先保留原后继，再重接前驱"
              ]
            ],
            "graph": {
              "nodes": [
                "a",
                "x",
                "b"
              ],
              "labels": {
                "a": "A",
                "x": "X",
                "b": "B"
              },
              "edges": [
                [
                  "a",
                  "x"
                ],
                [
                  "x",
                  "x"
                ]
              ],
              "directed": true
            }
          }
        }
      ]
    },
