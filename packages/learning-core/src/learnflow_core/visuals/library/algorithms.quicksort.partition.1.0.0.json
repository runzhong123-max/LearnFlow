    "teaching": {
      "goal": "跟踪扫描指针与小于等于 pivot 的已扫描区域。",
      "assumptions": [
        "人工维护的固定教学分镜；运行时只校验结构和绑定，不验证领域过程真值。",
        "固定末元素 pivot 的 Lomuto 分区；完成分区不等于全数组排序。"
      ],
      "misconceptions": [],
      "checkpoints": []
    },
    "parameters": [],
    "data": {
      "columns": [
        "对象 / 位置",
        "状态 / 内容"
      ],
      "stages": [
        {
          "id": "stage_0",
          "title": "选基准",
          "narration": "基准为末元素 3，i=-1，j 从 0 扫到 2。",
          "content": {
            "rows": [
              [
                "数组",
                "[4,2,5,3]"
              ],
              [
                "pivot",
                "3"
              ],
              [
                "i, j",
                "-1, 0"
              ]
            ],
            "items": [
              4,
              2,
              5,
              3
            ],
            "active_indices": [
              3
            ]
          }
        },
        {
          "id": "stage_1",
          "title": "扫描 4",
          "narration": "4 大于 3，不扩大小值区。",
          "content": {
            "rows": [
              [
                "数组",
                "[4,2,5,3]"
              ],
              [
                "小值区",
                "空"
              ],
              [
                "下一 j",
                "1"
              ]
            ],
            "items": [
              4,
              2,
              5,
              3
            ],
            "active_indices": [
              0,
              3
            ]
          }
        },
        {
          "id": "stage_2",
          "title": "扫描 2",
          "narration": "2 不大于 3，i 增为 0，并交换下标 0、1。",
          "content": {
            "rows": [
              [
                "数组",
                "[2,4,5,3]"
              ],
              [
                "小值区",
                "下标 0"
              ],
              [
                "下一 j",
                "2"
              ]
            ],
            "items": [
              2,
              4,
              5,
              3
            ],
            "active_indices": [
              0,
              1
            ]
          }
        },
        {
          "id": "stage_3",
          "title": "扫描 5",
          "narration": "5 大于 3，不交换。扫描完成。",
          "content": {
            "rows": [
              [
                "数组",
                "[2,4,5,3]"
              ],
              [
                "i",
                "0"
              ],
              [
                "大值已扫描区",
                "下标 1..2"
              ]
            ],
            "items": [
              2,
              4,
              5,
              3
            ],
            "active_indices": [
              2,
              3
            ]
          }
        },
        {
          "id": "stage_4",
          "title": "基准归位",
          "narration": "交换 i+1 与末位，左右区间还需要分别排序。",
          "content": {
            "rows": [
              [
                "数组",
                "[2,3,5,4]"
              ],
              [
                "pivot 下标",
                "1"
              ],
              [
                "右侧尚未有序",
                "[5,4]"
              ]
            ],
            "items": [
              2,
              3,
              5,
              4
            ],
            "active_indices": [
              1
            ]
          }
        }
      ]
    },
