    "data": {
      "columns": [
        "对象 / 位置",
        "状态 / 内容"
      ],
      "stages": [
        {
          "id": "stage_0",
          "title": "离线索引",
          "narration": "资料分块并保存来源位置，建立词法或向量索引。",
          "content": {
            "rows": [
              [
                "输入",
                "有权限的原始资料"
              ],
              [
                "输出",
                "带来源的 chunk 与索引"
              ]
            ],
            "graph": {
              "nodes": [
                "index",
                "retrieve",
                "rank",
                "context",
                "answer"
              ],
              "labels": {
                "index": "索引",
                "retrieve": "召回",
                "rank": "重排",
                "context": "上下文",
                "answer": "回答核查"
              },
              "edges": [],
              "directed": true
            }
          }
        },
        {
          "id": "stage_1",
          "title": "在线召回",
          "narration": "当前问题进入检索；先按用户权限过滤，再形成候选片段。",
          "content": {
            "rows": [
              [
                "输入",
                "问题与权限范围"
              ],
              [
                "输出",
                "候选 chunk"
              ],
              [
                "边界",
                "不是最终答案"
              ]
            ],
            "graph": {
              "nodes": [
                "index",
                "retrieve",
                "rank",
                "context",
                "answer"
              ],
              "labels": {
                "index": "索引",
                "retrieve": "召回",
                "rank": "重排",
                "context": "上下文",
                "answer": "回答核查"
              },
              "edges": [
                [
                  "index",
                  "retrieve"
                ]
              ],
              "directed": true
            }
          }
        },
        {
          "id": "stage_2",
          "title": "重排与选取",
          "narration": "对相关性、重复和预算进行选择，保留可回查来源。",
          "content": {
            "rows": [
              [
                "候选",
                "多个检索片段"
              ],
              [
                "结果",
                "有限证据片段及来源引用"
              ]
            ],
            "graph": {
              "nodes": [
                "index",
                "retrieve",
                "rank",
                "context",
                "answer"
              ],
              "labels": {
                "index": "索引",
                "retrieve": "召回",
                "rank": "重排",
                "context": "上下文",
                "answer": "回答核查"
              },
              "edges": [
                [
                  "index",
                  "retrieve"
                ],
                [
                  "retrieve",
                  "rank"
                ]
              ],
              "directed": true
            }
          }
        },
        {
          "id": "stage_3",
          "title": "装配上下文",
          "narration": "系统指令与检索资料隔离；资料作为证据，不作为可执行指令。",
          "content": {
            "rows": [
              [
                "控制层",
                "系统任务与规则"
              ],
              [
                "数据层",
                "问题与有来源的证据"
              ],
              [
                "缺口",
                "未找到支持时显式保留"
              ]
            ],
            "graph": {
              "nodes": [
                "index",
                "retrieve",
                "rank",
                "context",
                "answer"
              ],
              "labels": {
                "index": "索引",
                "retrieve": "召回",
                "rank": "重排",
                "context": "上下文",
                "answer": "回答核查"
              },
              "edges": [
                [
                  "index",
                  "retrieve"
                ],
                [
                  "retrieve",
                  "rank"
                ],
                [
                  "rank",
                  "context"
                ]
              ],
              "directed": true
            }
          }
        },
        {
          "id": "stage_4",
          "title": "生成与核查",
          "narration": "生成回答后核对声明与引用；无证据部分应说明缺口。",
          "content": {
            "rows": [
              [
                "输出",
                "回答与对应来源"
              ],
              [
                "检查",
                "引用是否支持声明"
              ],
              [
                "边界",
                "生成不等于验证"
              ]
            ],
            "graph": {
              "nodes": [
                "index",
                "retrieve",
                "rank",
                "context",
                "answer"
              ],
              "labels": {
                "index": "索引",
                "retrieve": "召回",
                "rank": "重排",
                "context": "上下文",
                "answer": "回答核查"
              },
              "edges": [
                [
                  "index",
                  "retrieve"
                ],
                [
                  "retrieve",
                  "rank"
                ],
                [
                  "rank",
                  "context"
                ],
                [
                  "context",
                  "answer"
                ]
              ],
              "directed": true
            }
          }
        }
      ]
    },
