    "domains": [
      "computer_science"
    ],
    "teaching": {
      "goal": "区分离线索引、在线检索、重排、上下文装配和有据生成。",
      "assumptions": [
        "人工维护的固定教学分镜；运行时只校验结构和绑定，不验证领域过程真值。",
        "结构流程示意，未运行真实搜索；检索命中不保证事实正确，引用需回到实际来源。"
      ],
      "misconceptions": [],
      "checkpoints": []
    },
