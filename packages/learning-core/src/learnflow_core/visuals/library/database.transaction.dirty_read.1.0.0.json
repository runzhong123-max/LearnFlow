    "data": {
      "columns": [
        "对象 / 位置",
        "状态 / 内容"
      ],
      "stages": [
        {
          "id": "stage_0",
          "title": "已提交初值",
          "narration": "数据库中余额的已提交值为 100。",
          "content": {
            "rows": [
              [
                "已提交余额",
                "100"
              ],
              [
                "事务 A",
                "尚未写入"
              ],
              [
                "事务 B",
                "尚未读取"
              ]
            ],
            "events": []
          }
        },
        {
          "id": "stage_1",
          "title": "A 写入未提交值",
          "narration": "A 把余额临时写为 0，但尚未提交。",
          "content": {
            "rows": [
              [
                "已提交值",
                "100"
              ],
              [
                "A 未提交值",
                "0"
              ],
              [
                "A 状态",
                "进行中"
              ]
            ],
            "events": [
              {
                "id": "write",
                "lane": "事务 A",
                "at": 1,
                "label": "写入 0，未提交"
              }
            ]
          }
        },
        {
          "id": "stage_2",
          "title": "B 读到 0",
          "narration": "在允许脏读的隔离下，B 看到了 A 尚未提交的值。",
          "content": {
            "rows": [
              [
                "B 读取结果",
                "0"
              ],
              [
                "来源",
                "A 的未提交写入"
              ]
            ],
            "events": [
              {
                "id": "write",
                "lane": "事务 A",
                "at": 1,
                "label": "写入 0，未提交"
              },
              {
                "id": "read",
                "lane": "事务 B",
                "at": 2,
                "label": "读到 0"
              }
            ]
          }
        },
        {
          "id": "stage_3",
          "title": "A 回滚",
          "narration": "A 的写入撤销，B 的读取却已基于从未提交过的值。",
          "content": {
            "rows": [
              [
                "已提交余额",
                "100"
              ],
              [
                "B 先前读到",
                "0"
              ],
              [
                "现象",
                "脏读"
              ]
            ],
            "events": [
              {
                "id": "write",
                "lane": "事务 A",
                "at": 1,
                "label": "写入 0，未提交"
              },
              {
                "id": "read",
                "lane": "事务 B",
                "at": 2,
                "label": "读到 0"
              },
              {
                "id": "rollback",
                "lane": "事务 A",
                "at": 3,
                "label": "回滚"
              }
            ]
          }
        },
        {
          "id": "stage_4",
          "title": "隔离边界",
          "narration": "READ COMMITTED 不允许读到该未提交值；等待还是读旧版本取决于实现。",
          "content": {
            "rows": [
              [
                "保证",
                "不读取未提交写入"
              ],
              [
                "未保证",
                "同一事务中两次读取一定相同"
              ]
            ],
            "events": [
              {
                "id": "write",
                "lane": "事务 A",
                "at": 1,
                "label": "写入 0，未提交"
              },
              {
                "id": "read",
                "lane": "事务 B",
                "at": 2,
                "label": "读到 0"
              },
              {
                "id": "rollback",
                "lane": "事务 A",
                "at": 3,
                "label": "回滚"
              }
            ]
          }
        }
      ],
      "lanes": [
        "事务 A",
        "事务 B"
      ]
    },
